# Copy to v2/.env. Never commit your real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
DATABASE_PATH=data/brainstorm.db
# Production uses DATABASE_URL instead of DATABASE_PATH.
DATABASE_URL=
# langgraph enables durable V3 stage generation; v2 selects the legacy engine.
WORKFLOW_ENGINE=langgraph
AUTH_REQUIRED=false
ALLOW_SIGNUPS=true
INVITE_CODE=
COOKIE_SECURE=false
SESSION_DAYS=30
DAILY_GENERATION_LIMIT=0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
